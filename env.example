# Optional AI species-identification provider. Keep these values server-side.
AI_ENABLED=0
AI_PROTOCOL=openai-compatible
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=20000

# Centralized anonymous feedback inbox (Supabase REST API).
# Keep the service-role key server-side; never use it in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cloudflare Workers AI REST provider.
# Set AI_PROTOCOL=cloudflare and fill these instead of the OpenAI-compatible fields.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# AI_MODEL=@cf/llava-hf/llava-1.5-7b-hf
